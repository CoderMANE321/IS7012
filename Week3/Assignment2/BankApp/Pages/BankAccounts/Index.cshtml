@page
@model BankApp.Pages.BankAccounts.IndexModel

@{
    ViewData["Title"] = "Bank Accounts";
}

<h1>Bank Accounts</h1>

<p>
    <a asp-page="Create">Create New Bank Account</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Account Holder
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].AccountNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].AccountType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAccount[0].Balance)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BankAccount) {
        <tr>
            <td>
                @item.AccountHolder?.FullName
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Balance)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.BankAccountId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.BankAccountId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.BankAccountId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
