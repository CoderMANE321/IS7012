@page
@model BankApp.Pages.AccountHolders.DetailsModel

@{
    ViewData["Title"] = "Account Holder Details";
}

<h1>Account Holder Details</h1>

<div>
    <h4>Account Holder</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.FirstName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.Email)
        </dd>
    </dl>

    @if (Model.AccountHolder.BankAccounts.Any())
    {
        <div>
            <h4>Bank Accounts</h4>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Account Number</th>
                        <th>Account Type</th>
                        <th>Balance</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.AccountHolder.BankAccounts)
                    {
                        <tr>
                            <td>
                                @item.BankAccount?.AccountNumber
                            </td>
                            <td>
                                @item.BankAccount?.AccountType
                            </td>
                            <td>
                                @item.BankAccount?.Balance.ToString("C2")
                            </td>
                        </tr>
                    }

                    @{
                        var totalBalance = Model.AccountHolder.BankAccounts
                            .Sum(x => x.BankAccount?.Balance ?? 0m);
                    }

                    <tr>
                        <td></td>
                        <td><strong>Total Balance</strong></td>
                        <td>
                            <strong>@totalBalance.ToString("C2")</strong>
                        </td>
                    </tr>
                </tbody>
            </table>

            <p>
                <strong>
                    @Model.AccountHolder.BankAccounts.Count Account(s) Found
                </strong>
            </p>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No Bank Accounts Exist for this Account Holder.
        </div>
    }
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.AccountHolder.AccountHolderId">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
