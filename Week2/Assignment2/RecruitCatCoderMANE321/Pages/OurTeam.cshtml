@page

@{
    ViewData["Title"] = "Our Team";
}

<section class="hero py-5">
    <div class="container">
        <p class="fw-bold text-uppercase">Meet RecruitCat</p>

        <h1 class="display-5 fw-bold">People who understand your potential.</h1>

        <p class="lead mb-0">
            Technical experience, thoughtful conversations,
            and a shared commitment to helping people grow.
        </p>
    </div>
</section>

<section class="container py-5" aria-label="Team profiles">
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <article class="card h-100 border-0 shadow-sm">
                <img src="~/images/ProfilePic.jpg"
                     class="card-img-top team-photo"
                     alt="Deonta Williams, founder of RecruitCat in a professional setting." />

                <div class="card-body p-4">
                    <h2 class="h4">Deonta Williams</h2>
                    <p class="text-primary fw-semibold">
                        Founder &amp; Technology Recruiting Lead
                    </p>

                    <p>
                        Deonta brings experience in software development,
                        data engineering, business intelligence, and enterprise
                        applications. He is pursuing a Master of Science in
                        Information Systems at the University of Cincinnati.
                    </p>

                    <p>
                        His interest in connecting technology with business
                        helps him understand both a candidate’s abilities
                        and an employer’s needs. Outside of technology,
                        he enjoys running and fitness.
                    </p>

                    <a href="https://github.com/CoderMANE321"
                       class="btn btn-outline-primary">
                        Explore Deonta’s projects
                    </a>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-lg-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="team-initials initials-blue" aria-hidden="true">
                    JM
                </div>

                <div class="card-body p-4">
                    <h2 class="h4">Jordan Mitchell</h2>
                    <p class="text-primary fw-semibold">
                        Senior Technical Recruiter
                    </p>

                    <p>
                        Jordan specializes in connecting software developers
                        and data professionals with teams that value
                        curiosity, collaboration, and practical problem solving.
                    </p>

                    <p>
                        Jordan helps candidates explain their project experience
                        and prepare for meaningful technical conversations.
                        Outside of work, Jordan enjoys hiking and photography.
                    </p>

                    <span class="badge bg-light text-dark">
                        Software &amp; Data
                    </span>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-lg-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="team-initials initials-purple" aria-hidden="true">
                    AL
                </div>

                <div class="card-body p-4">
                    <h2 class="h4">Avery Lewis</h2>
                    <p class="text-primary fw-semibold">
                        Client Partnerships Manager
                    </p>

                    <p>
                        Avery works with employers to understand their hiring
                        priorities, team culture, and long-term goals before
                        helping shape a focused recruiting plan.
                    </p>

                    <p>
                        Avery believes clear communication makes hiring better
                        for everyone. Outside of work, Avery enjoys volunteering,
                        exploring local restaurants, and reading.
                    </p>

                    <span class="badge bg-light text-dark">
                        Employer Partnerships
                    </span>
                </div>
            </article>
        </div>
    </div>
</section>